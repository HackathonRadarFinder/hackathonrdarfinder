
# PostgreSQL
POSTGRES_DB=hackathon_radar
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=replace_with_secure_password

# Docker database connection
DATABASE_URL=postgresql+psycopg://radar_user:replace_with_secure_password@db:5432/hackathon_radar

# Application
SECRET_KEY=replace_with_random_secret
APP_NAME=Hackathon Radar AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
