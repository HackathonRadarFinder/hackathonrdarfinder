
# ==========================================
# Hackathon Radar Finder - Environment
# ==========================================

# Authentication
# Replace this placeholder with a unique, random secret.
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
POSTGRES_DB=hackathon_radar
POSTGRES_USER=radar_user
POSTGRES_PASSWORD=replace_with_secure_password

# Database connection for Docker Compose
DATABASE_URL=postgresql+psycopg://radar_user:replace_with_secure_password@db:5432/hackathon_radar
# Email reminders are disabled until explicitly configured and deployed.
EMAIL_MODE=disabled
# OTP reset is independent from event reminder emails.
# Render Free blocks outgoing SMTP; use Resend HTTPS email API instead.
# Verify your sending domain and provision RESEND_API_KEY and EMAIL_FROM in
# Render server-side environment only. Never put the key in frontend VITE_* vars.
PASSWORD_RESET_OTP_ENABLED=false
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_TIMEOUT=10
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
