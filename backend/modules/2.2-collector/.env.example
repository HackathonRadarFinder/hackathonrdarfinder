# Copy to .env and edit. Identify yourself honestly - include a contact address/URL.
COLLECTOR_USER_AGENT=Module22Collector/1.0 (+https://github.com/YOUR_ORG/YOUR_REPO; contact: you@example.com)
COLLECTOR_MIN_DELAY=1.0
COLLECTOR_MAX_DELAY=2.0
COLLECTOR_MAX_ATTEMPTS=3
COLLECTOR_BACKOFF_BASE=2.0
COLLECTOR_REQUEST_TIMEOUT=30
COLLECTOR_RAW_DATA_DIR=data/raw
COLLECTOR_LOG_DIR=logs
COLLECTOR_LOG_LEVEL=INFO

# Honest contact sent as the From: header (optional but recommended)
COLLECTOR_CONTACT_EMAIL=you@example.com
# Optional Slack-style webhook that is called when a source blocks us
COLLECTOR_ALERT_WEBHOOK_URL=
# Raw storage backend: local (data/raw) or s3 (uses standard AWS credentials)
COLLECTOR_STORAGE=local
COLLECTOR_S3_BUCKET=
COLLECTOR_S3_PREFIX=raw/

# false = show the browser window for dynamic sources
COLLECTOR_HEADLESS=true
COLLECTOR_SLOW_MO_MS=0        # headed only: e.g. 400 slows each browser action
COLLECTOR_HOLD_SECONDS=0     # headed only: e.g. 5 keeps the window open 5s before closing
