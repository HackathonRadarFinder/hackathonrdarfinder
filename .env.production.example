# Copy to a private .env.production; never use these placeholders as credentials.
POSTGRES_USER=radar
POSTGRES_DB=radar_production
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://radar:REPLACE_WITH_RANDOM_PASSWORD@db:5432/radar_production
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
EMAIL_MODE=disabled
DEBUG=false
ENVIRONMENT=production
# Optional, only after obtaining a key and registering a valid source policy:
BRABBLE_API_KEY=
# HTTPS requires an owner-configured public domain with DNS and ports 80/443.
DOMAIN=radar.example.invalid
HTTP_PORT=8080
