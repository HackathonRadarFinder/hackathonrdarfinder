# Shared local development defaults.
# Copy to .env and adjust as needed for your workstation.
APP_ENV=development
SECRET_KEY=change-me-dev-secret-key
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/hackathon_radar
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
POSTGRES_DB=hackathon_radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
